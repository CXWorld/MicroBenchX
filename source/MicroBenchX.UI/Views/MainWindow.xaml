<Window x:Class="MicroBenchX.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:MicroBenchX.UI.Views"
        xmlns:vm="clr-namespace:MicroBenchX.UI.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="768"
        Width="1280"
        MinHeight="768"
        MinWidth="1280"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBackgroundBrush}"
                Padding="20,15">
            <TextBlock Text="{Binding Title}"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource HeaderForegroundBrush}" />
        </Border>

        <!-- Tab Control -->
        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Style="{StaticResource ModernTabControlStyle}">

            <!-- PPC Tab -->
            <TabItem Header="PPC" Style="{StaticResource ModernTabItemStyle}">
                <views:PpcView DataContext="{Binding PpcViewModel}" />
            </TabItem>

            <!-- IPC Tab -->
            <TabItem Header="IPC" Style="{StaticResource ModernTabItemStyle}">
                <views:IpcView DataContext="{Binding IpcViewModel}" />
            </TabItem>

            <!-- Latency Tab -->
            <TabItem Header="Latency" Style="{StaticResource ModernTabItemStyle}">
                <views:LatencyView DataContext="{Binding LatencyViewModel}" />
            </TabItem>

            <!-- Info Tab -->
            <TabItem Header="Info" Style="{StaticResource ModernTabItemStyle}">
                <views:InfoView DataContext="{Binding InfoViewModel}" />
            </TabItem>

        </TabControl>
    </Grid>
</Window>
